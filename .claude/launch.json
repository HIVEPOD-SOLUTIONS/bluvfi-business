{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "bluvfi-business",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--",
        "-p",
        "3100"
      ],
      "port": 3100
    },
    {
      "name": "bluvfi-business-demo",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "demo:ui",
        "--",
        "3101"
      ],
      "port": 3101
    },
    {
      "name": "bluvfi-business-demo-aurora",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "demo:ui",
        "--",
        "3102"
      ],
      "port": 3102,
      "env": {
        "AURORA_API_KEY": "placeholder-key"
      }
    }
  ]
}
