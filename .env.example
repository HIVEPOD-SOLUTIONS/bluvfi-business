# Copy to .env.local and fill in. Never commit real values.
# Nothing here is needed for `npm run demo` or `npm run demo:ui`.

# ---------- Required ----------
# 64 hex characters. Derives the record encryption, ML-DSA signing and session keys.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BLUVFI_MASTER_KEY=
# Better in production: a file holding it (a mounted Docker/Kubernetes secret, or one a secrets manager writes at boot).
# It decrypts every business's stored keys, so keep it out of this file there. Wins over BLUVFI_MASTER_KEY.
BLUVFI_MASTER_KEY_FILE=
# Who may approve: name:token pairs, tokens of 16+ characters.
BLUVFI_SIGNERS=maya:change-me-0123456789,devon:change-me-9876543210
# Distinct signers needed to change policy.
APPROVAL_THRESHOLD_SIGNERS=2
# NEAR AI Cloud key (https://cloud.near.ai; $10 free credits via https://nearbuilders.org/join).
NEAR_AI_API_KEY=
NEAR_AI_MODEL=zai-org/GLM-5.1-FP8

# ---------- Custody: pick one (CUSTODY=sputnik | outlayer | hybrid | manual; inferred if unset) ----------
# hybrid = the Sputnik DAO below is the vault, the OutLayer wallet below is the spending wallet. Set both blocks.
# Easiest: leave this block empty, run npm run dev and open /setup to do it all from the browser with your NEAR wallet.
# Optional: a Privy app ID (https://dashboard.privy.io) lets /setup pay with an email or Google login instead of a
# NEAR wallet: Privy keeps a NEAR wallet for the person. Add your app URL (e.g. http://localhost:3000) to its allowed origins.
PRIVY_APP_ID=
# With PRIVY_APP_ID and PRIVY_APP_SECRET set, this is a multi-business platform: anyone can sign in with an email or Google login
# and create their own business, which gets its own records, team and treasury. The secret is in the same Privy dashboard under
# App settings > Basic. It stays on the server: never prefix it with NEXT_PUBLIC_ or commit it.
PRIVY_APP_SECRET=
# Optional: emails that own the operator's OWN business (the one configured by this file). BLUVFI_SIGNERS works too.
BLUVFI_OWNER_EMAIL=
# BLUVFI_SIGNUP=closed stops new businesses from signing up; existing ones keep working.
BLUVFI_SIGNUP=
# Shortcut: npm run mainnet:setup -- --funder you.near --council you.near,partner.near --name yourteam
#   prints the plan; add --yes (with MAINNET_FUNDER_KEY set) to do steps 1-4 below and fill in .env.local.
# Sputnik DAO / Trezu treasury. The agent key must be a FUNCTION-CALL key on AGENT_ACCOUNT with
# receiver DAO_ACCOUNT and method add_proposal, and the DAO's proposal_bond must be 0. The app checks both.
# 1. Make a key pair; the first line printed (the secret) goes in AGENT_PRIVATE_KEY:
#   node -e "const {KeyPair}=require('near-api-js');const k=KeyPair.fromRandom('ed25519');console.log(k.toString());console.log(k.getPublicKey().toString())"
# 2. The account owner adds the public key as a function-call key:
#   near account add-key acme-agent.near grant-function-call-access --allowance '0.25 NEAR' \
#     --contract-account-id acme.sputnik-dao.near --function-names add_proposal \
#     use-manually-provided-public-key ed25519:<public key> network-config mainnet sign-with-keychain send
# 3. Give acme-agent.near a DAO role with only call:AddProposal and transfer:AddProposal (Trezu's Requestor).
# 4. Delete every other key on acme-agent.near, including its full-access key, so it holds only the scoped key:
#   near account delete-keys acme-agent.near public-keys ed25519:<full-access key> network-config mainnet sign-with-keychain send
#   The account can then never add a key again: if the key's allowance runs out, make a new agent account (steps 1-4)
#   and have the council swap it into the role. The relayer below must not be a council member.
DAO_ACCOUNT=
AGENT_ACCOUNT=
AGENT_PRIVATE_KEY=
# Optional: pays gas for council votes sent as meta transactions (only act_proposal on DAO_ACCOUNT is relayed).
RELAYER_ACCOUNT=
RELAYER_PRIVATE_KEY=
# The relayer's key must be full-access, so keep only gas money on it; the custody check warns above this many NEAR.
RELAYER_MAX_NEAR=5
TREZU_APP_URL=https://trezu.app

# OutLayer agent wallet (https://app.outlayer.ai): the owner sets limits, approvers and freeze in its dashboard.
OUTLAYER_API_KEY=
OUTLAYER_BASE_URL=https://api.outlayer.ai
# On by default: payouts are refused unless OutLayer's own per-payment and daily limits are set and within this app's
# policy, since the API key can spend up to them. 0 turns it off.
REQUIRE_CUSTODIAN_LIMITS=1
# Hybrid only: the OutLayer wallet's NEAR account. Its per-payment USDC limit must be at or under the approval threshold.
OUTLAYER_WALLET_ACCOUNT=
# Hybrid only: refill below this USDC balance, up to the target (defaults: the daily limit, and twice it).
SPENDING_WALLET_LOW_USD=
SPENDING_WALLET_TARGET_USD=

# Treasury account for balances and 1Click refunds. Defaults to DAO_ACCOUNT with Sputnik or hybrid custody.
TREASURY_ACCOUNT=

# ---------- Payments ----------
# Optional 1Click key (https://partners.near-intents.org); without it 1Click charges 0.2%.
ONECLICK_JWT=
# 1 = dry-run quotes only: real prices, no deposit address, nothing can be paid. Good for judging.
ONECLICK_DRY=

# Aurora Widget Studio key (https://studio.aurora.dev, self-serve, public): pay links show Aurora's wallet widget,
# so clients pay from any wallet and token. Without it, pay links show a deposit address instead.
AURORA_API_KEY=

# ---------- Vendor callbacks ----------
COMPANY_NAME=Acme Inc
PUBLIC_BASE_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ---------- Bluvfi Business Check (sold per call over x402) ----------
# PingPay Agent Pay facilitator (buyers pay USDC on Base, you receive USDC on NEAR)...
PINGPAY_API_KEY=
# As of 2026-11-04 the facilitator answers on both https://pay.pingpay.io (the default) and https://staging.pingpay.io.
# The app checks GET /agentpay/x402/supported before taking payments either way.
# PINGPAY_BASE_URL=https://pay.pingpay.io
# ...or any x402 facilitator that supports network "near".
X402_FACILITATOR_URL=
# Signs x402 payments when the agent buys an API (POST /pay). Not bundled.
X402_PAYER_URL=
# The payer service's shared secret (print it with `npm run x402:payer -- token` after `setup`), and X402_TESTNET=1 to let the agent pay in free Base Sepolia test USDC.
X402_PAYER_TOKEN=
# The payer's and the confidential-test account's key files are encrypted under this passphrase (required on mainnet).
# Set it in your shell when you run those scripts, NOT in this file: anyone who can read this file could then read them.
#   BLUVFI_KEYFILE_PASSPHRASE=...
X402_TESTNET=
# With X402_TESTNET=1 and an EVM address here, Check is also sold for free Base Sepolia test USDC through the public x402.org facilitator (the whole selling path can be run for real).
X402_PAYTO_EVM=
# Archive node for the "contract code changed in the last 30 days" check (default: FastNEAR's).
# NEAR_ARCHIVAL_RPC_URL=https://archival-rpc.mainnet.fastnear.com

# ---------- Agent Market worker ----------
AGENT_MARKET_TOKEN=
AGENT_MARKET_CRON_SECRET=
# Confidential treasuries (lib/confidential.ts): the 1Click host that serves Confidential Intents, and the MPC signer. Defaults are right for mainnet.
# CONFIDENTIAL_TREASURY=1 makes this treasury confidential: its balance is shielded and each payout is signed by NEAR's MPC signer after the council approves it.
# Needs Sputnik custody, your 1Click partner key in ONECLICK_JWT, and a council login on the Overview (about weekly).
CONFIDENTIAL_TREASURY=
# CONFIDENTIAL_API_URL=https://1click.chaindefuser.com
# MPC_SIGNER_CONTRACT=v1.signer
# A scheduler that POSTs /api/settlement/poll with "Authorization: Bearer <this>" settles every business's open payouts and payment links.
SETTLEMENT_CRON_SECRET=

# ---------- Identity verification (KYB), through Persona (https://withpersona.com; the sandbox is free) ----------
# Vendors and signed-up businesses are sent a hosted verification link; Persona's approve or decline comes back by webhook (POST /api/kyb/webhook)
# and is confirmed against Persona's API. Create two KYB inquiry templates (itmpl_...) with a decision workflow that approves or declines.
PERSONA_API_KEY=
PERSONA_TEMPLATE_VENDOR=
PERSONA_TEMPLATE_BUSINESS=
PERSONA_WEBHOOK_SECRET=
# KYB_REQUIRED=1: a signed-up business cannot release any payment until its own verification is approved. Without it, the council's
# policy decides (Policy page: "Who has to verify, and when"): by amount, for new vendors, or for confidential payments.
KYB_REQUIRED=
# Short retention: days after Persona's final decision before the app asks Persona to delete the documents (only the decision is
# kept). Default 7, so an attester can still re-check it for a credential. "off" never deletes.
PERSONA_REDACT_AFTER_DAYS=7

# ---------- Passport proofs (Self, self.xyz): verification with no documents ----------
# The person opens a hosted link; the Self app reads their passport chip and proves "real passport holder, of age, not on OFAC lists"
# in zero knowledge, sharing no name, number or document. In Self's dashboard build a flow with OFAC screening and a minimum age and no
# disclosures, point its webhook at PUBLIC_BASE_URL/api/passport/webhook, then set all four:
SELF_API_KEY=
SELF_FLOW_ID=
SELF_WEBHOOK_SECRET=
SELF_ORG_ID=
# 1 = also accept Self's test environment (mock documents), for trying it without a real passport.
SELF_ALLOW_TEST=
# Sanctions screening needs no key: the OFAC list is downloaded from the US Treasury and refreshed daily (cached in .data/sanctions.json).

# ---------- Zero-knowledge claims: who attests ----------
# Credentials and balance proofs are signed by this app and, optionally, by up to two independent attesters (npm run zk:attester, run by someone
# else) that check the fact themselves. ZK_ATTEST_THRESHOLD is how many different issuers must sign before such a proof is made.
# Format: url|token|attester public key, separated by semicolons.  Put the issuer set to the DAO from the Proofs page to record it on chain.
ZK_ATTESTERS=
ZK_ATTEST_THRESHOLD=

# ---------- Optional overrides ----------
NEAR_RPC_URL=https://rpc.mainnet.near.org
EVM_RPC_URL=https://ethereum-rpc.publicnode.com
NEARBLOCKS_API_KEY=
